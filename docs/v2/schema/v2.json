{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trogers1/sidecar-comments/docs/v2/schema/v2.json",
  "title": "Sidecar Comments v2 normative contract",
  "description": "Public protocol instances. Persistence metadata is validated separately against #/$defs/ThreadMetadata. Unchanged leaf DTOs reference the frozen v1 schema. Prose supplies token, byte, lifecycle, source and cross-field checks.",
  "oneOf": [{"$ref":"#/$defs/SuccessEnvelope"},{"$ref":"#/$defs/ErrorEnvelope"},{"$ref":"#/$defs/ApplyRequest"},{"$ref":"#/$defs/EditorUpdateRequest"}],
  "$defs": {
    "ThreadID":{"$ref":"../../v1/schema/v1.json#/$defs/ThreadID"},
    "MessageID":{"$ref":"../../v1/schema/v1.json#/$defs/MessageID"},
    "Revision":{"$ref":"../../v1/schema/v1.json#/$defs/Revision"},
    "RevisionOrNull":{"$ref":"../../v1/schema/v1.json#/$defs/RevisionOrNull"},
    "RevisionGuard":{"$ref":"../../v1/schema/v1.json#/$defs/RevisionGuard"},
    "PositiveInt":{"$ref":"../../v1/schema/v1.json#/$defs/PositiveInt"},
    "Index":{"$ref":"../../v1/schema/v1.json#/$defs/Index"},
    "AuthorDTO":{"$ref":"../../v1/schema/v1.json#/$defs/AuthorDTO"},
    "GitLabDTO":{"$ref":"../../v1/schema/v1.json#/$defs/GitLabDTO"},
    "Body":{"$ref":"../../v1/schema/v1.json#/$defs/Body"},
    "MessageDTO":{"$ref":"../../v1/schema/v1.json#/$defs/MessageDTO"},
    "WarningDTO":{"$ref":"../../v1/schema/v1.json#/$defs/WarningDTO"},
    "LineLocation":{"type":"object","properties":{"kind":{"const":"line"},"line":{"$ref":"#/$defs/PositiveInt"}},"required":["kind","line"],"additionalProperties":false},
    "RangeLocation":{"type":"object","properties":{"kind":{"const":"range"},"start_line":{"$ref":"#/$defs/PositiveInt"},"start_column":{"$ref":"#/$defs/PositiveInt"},"end_line":{"$ref":"#/$defs/PositiveInt"},"end_column":{"$ref":"#/$defs/PositiveInt"}},"required":["kind","start_line","start_column","end_line","end_column"],"additionalProperties":false},
    "AttachedLocation":{"oneOf":[{"$ref":"#/$defs/LineLocation"},{"$ref":"#/$defs/RangeLocation"}]},
    "InputLocation":{"oneOf":[{"$ref":"#/$defs/AttachedLocation"},{"type":"object","properties":{"kind":{"enum":["file","lost"]}},"required":["kind"],"additionalProperties":false}]},
    "LocationDTO":{"oneOf":[{"$ref":"#/$defs/InputLocation"},{"type":"object","properties":{"kind":{"const":"unresolved"}},"required":["kind"],"additionalProperties":false}]},
    "TrackingSummary":{"type":"object","properties":{"version":{"const":1},"source_revision":{"$ref":"#/$defs/Revision"},"last_location":{"$ref":"#/$defs/AttachedLocation"},"prefix_at_start":{"type":"boolean"},"suffix_at_end":{"type":"boolean"}},"required":["version","source_revision","last_location","prefix_at_start","suffix_at_end"],"additionalProperties":false},
    "TrackingRecord":{"type":"object","properties":{"version":{"const":1},"source_revision":{"$ref":"#/$defs/Revision"},"last_location":{"$ref":"#/$defs/AttachedLocation"},"selected_text":{"type":"string","maxLength":4096},"prefix":{"type":"string","maxLength":256},"suffix":{"type":"string","maxLength":256},"prefix_at_start":{"type":"boolean"},"suffix_at_end":{"type":"boolean"}},"required":["version","source_revision","last_location","selected_text","prefix","suffix","prefix_at_start","suffix_at_end"],"additionalProperties":false},
    "ThreadMetadata":{"type":"object","properties":{"tracking":{"$ref":"#/$defs/TrackingRecord"}},"additionalProperties":false},
    "ThreadDTO":{"type":"object","properties":{"id":{"$ref":"#/$defs/ThreadID"},"location":{"$ref":"#/$defs/LocationDTO"},"messages":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/MessageDTO"}},"tracking":{"$ref":"#/$defs/TrackingSummary"}},"required":["id","location","messages"],"additionalProperties":false,"allOf":[{"$ref":"#/$defs/TrackingPresence"}]},
    "StoredThread":{"type":"object","properties":{"id":{"$ref":"#/$defs/ThreadID"},"location":{"$ref":"#/$defs/LocationDTO"},"messages":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/MessageDTO"}},"tracking":{"$ref":"#/$defs/TrackingRecord"}},"required":["id","location","messages"],"additionalProperties":false,"allOf":[{"$ref":"#/$defs/TrackingPresence"}]},
    "TrackingPresence":{"if":{"properties":{"location":{"properties":{"kind":{"enum":["line","range","unresolved"]}},"required":["kind"]}},"required":["location"]},"then":{"required":["tracking"]},"else":{"not":{"required":["tracking"]}}},
    "StoredDocument":{"type":"object","properties":{"format":{"const":2},"threads":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/StoredThread"}}},"required":["format","threads"],"additionalProperties":false},
    "Operation":{"oneOf":[
      {"type":"object","properties":{"op":{"const":"thread_create"},"thread_id":{"$ref":"#/$defs/ThreadID"},"message_id":{"$ref":"#/$defs/MessageID"},"location":{"$ref":"#/$defs/InputLocation"},"author":{"$ref":"#/$defs/AuthorDTO"},"body":{"$ref":"#/$defs/Body"},"gitlab":{"$ref":"#/$defs/GitLabDTO"}},"required":["op","thread_id","message_id","location","author","body"],"additionalProperties":false},
      {"type":"object","properties":{"op":{"const":"thread_move"},"thread_id":{"$ref":"#/$defs/ThreadID"},"location":{"$ref":"#/$defs/InputLocation"}},"required":["op","thread_id","location"],"additionalProperties":false},
      {"$ref":"../../v1/schema/v1.json#/$defs/Operation/oneOf/2"},
      {"$ref":"../../v1/schema/v1.json#/$defs/Operation/oneOf/3"},
      {"$ref":"../../v1/schema/v1.json#/$defs/Operation/oneOf/4"},
      {"$ref":"../../v1/schema/v1.json#/$defs/Operation/oneOf/5"}
    ]},
    "ApplyRequest":{"type":"object","properties":{"protocol":{"const":2},"if_revision":{"$ref":"#/$defs/RevisionGuard"},"if_source_revision":{"$ref":"#/$defs/Revision"},"operations":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/Operation"}}},"required":["protocol","operations"],"additionalProperties":false},
    "EditorUpdate":{"oneOf":[{"type":"object","properties":{"thread_id":{"$ref":"#/$defs/ThreadID"},"location":{"$ref":"#/$defs/AttachedLocation"}},"required":["thread_id","location"],"additionalProperties":false},{"type":"object","properties":{"thread_id":{"$ref":"#/$defs/ThreadID"},"deleted":{"const":true}},"required":["thread_id","deleted"],"additionalProperties":false}]},
    "EditorUpdateRequest":{"type":"object","properties":{"protocol":{"const":2},"if_revision":{"$ref":"#/$defs/RevisionGuard"},"source_revision":{"$ref":"#/$defs/Revision"},"updates":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/EditorUpdate"}}},"required":["protocol","if_revision","source_revision","updates"],"additionalProperties":false},
    "SourceInspectResult":{"type":"object","properties":{"source_revision":{"$ref":"#/$defs/Revision"},"line_count":{"$ref":"#/$defs/PositiveInt"},"byte_count":{"type":"integer","minimum":0,"maximum":16777216}},"required":["source_revision","line_count","byte_count"],"additionalProperties":false},
    "Outcome":{"type":"object","properties":{"thread_id":{"$ref":"#/$defs/ThreadID"},"outcome":{"enum":["unchanged","moved","modified","unresolved","skipped"]},"reason":{"enum":["source_unchanged","exact_match","context_replacement","boundary_expansion","editor_location","editor_deleted","no_match","ambiguous","insufficient_context","unsupported_transformation","selection_too_large","search_limit","file","lost"]},"evidence":{"enum":["unchanged","exact","inferred","editor","none"]},"location":{"$ref":"#/$defs/LocationDTO"}},"required":["thread_id","outcome","reason","evidence","location"],"additionalProperties":false},
    "SyncResult":{"type":"object","properties":{"check":{"type":"boolean"},"would_change":{"type":"boolean"},"source_revision":{"$ref":"#/$defs/Revision"},"previous_storage_revision":{"$ref":"#/$defs/RevisionOrNull"},"storage_revision":{"$ref":"#/$defs/RevisionOrNull"},"canonical_revision":{"$ref":"#/$defs/Revision"},"outcomes":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/Outcome"}}},"required":["check","would_change","previous_storage_revision","storage_revision","canonical_revision","outcomes"],"additionalProperties":false},
    "EditorUpdateResult":{"type":"object","properties":{"source_revision":{"$ref":"#/$defs/Revision"},"storage_revision":{"$ref":"#/$defs/Revision"},"canonical_revision":{"$ref":"#/$defs/Revision"},"outcomes":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/Outcome"}}},"required":["source_revision","storage_revision","canonical_revision","outcomes"],"additionalProperties":false},
    "VersionResult":{"type":"object","properties":{"cli_version":{"type":"string","minLength":1},"format_version":{"const":2},"protocol":{"const":2}},"required":["cli_version","format_version","protocol"],"additionalProperties":false},
    "ListResult":{"type":"object","properties":{"threads":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/ThreadDTO"}},"warnings":{"type":"array","items":{"$ref":"#/$defs/WarningDTO"}},"storage_revision":{"$ref":"#/$defs/RevisionOrNull"},"canonical_revision":{"$ref":"#/$defs/Revision"}},"required":["threads","warnings","storage_revision","canonical_revision"],"additionalProperties":false},
    "TrackingListResult":{"type":"object","properties":{"threads":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/StoredThread"}},"warnings":{"type":"array","items":{"$ref":"#/$defs/WarningDTO"}},"storage_revision":{"$ref":"#/$defs/RevisionOrNull"},"canonical_revision":{"$ref":"#/$defs/Revision"}},"required":["threads","warnings","storage_revision","canonical_revision"],"additionalProperties":false},
    "GetResult":{"type":"object","properties":{"thread":{"$ref":"#/$defs/ThreadDTO"},"storage_revision":{"$ref":"#/$defs/Revision"},"canonical_revision":{"$ref":"#/$defs/Revision"}},"required":["thread","storage_revision","canonical_revision"],"additionalProperties":false},
    "TrackingGetResult":{"type":"object","properties":{"thread":{"$ref":"#/$defs/StoredThread"},"storage_revision":{"$ref":"#/$defs/Revision"},"canonical_revision":{"$ref":"#/$defs/Revision"}},"required":["thread","storage_revision","canonical_revision"],"additionalProperties":false},
    "CreateResult":{"type":"object","properties":{"thread":{"$ref":"#/$defs/ThreadDTO"},"storage_revision":{"$ref":"#/$defs/Revision"},"canonical_revision":{"$ref":"#/$defs/Revision"},"generated_ids":{"$ref":"../../v1/schema/v1.json#/$defs/GeneratedIDsDTO"}},"required":["thread","storage_revision","canonical_revision"],"additionalProperties":false},
    "MessageResult":{"type":"object","properties":{"thread":{"$ref":"#/$defs/ThreadDTO"},"message":{"$ref":"#/$defs/MessageDTO"},"storage_revision":{"$ref":"#/$defs/Revision"},"canonical_revision":{"$ref":"#/$defs/Revision"}},"required":["thread","message","storage_revision","canonical_revision"],"additionalProperties":false},
    "AddResult":{"type":"object","properties":{"thread":{"$ref":"#/$defs/ThreadDTO"},"message":{"$ref":"#/$defs/MessageDTO"},"storage_revision":{"$ref":"#/$defs/Revision"},"canonical_revision":{"$ref":"#/$defs/Revision"},"generated_id":{"$ref":"#/$defs/MessageID"}},"required":["thread","message","storage_revision","canonical_revision"],"additionalProperties":false},
    "OperationResult":{"type":"object","properties":{"index":{"$ref":"#/$defs/Index"},"op":{"enum":["thread_create","thread_move","thread_delete","message_add","message_update","message_delete"]},"changed":{"type":"boolean"},"result":{"type":"object"}},"required":["index","op","changed","result"],"additionalProperties":false,"allOf":[
      {"if":{"properties":{"op":{"enum":["thread_create","thread_move"]}}},"then":{"properties":{"result":{"type":"object","properties":{"thread":{"$ref":"#/$defs/ThreadDTO"}},"required":["thread"],"additionalProperties":false}}}},
      {"if":{"properties":{"op":{"enum":["message_add","message_update"]}}},"then":{"properties":{"result":{"type":"object","properties":{"thread":{"$ref":"#/$defs/ThreadDTO"},"message":{"$ref":"#/$defs/MessageDTO"}},"required":["thread","message"],"additionalProperties":false}}}},
      {"if":{"properties":{"op":{"const":"thread_delete"}}},"then":{"properties":{"changed":{"const":true},"result":{"type":"object","properties":{"deleted_thread_id":{"$ref":"#/$defs/ThreadID"}},"required":["deleted_thread_id"],"additionalProperties":false}}}},
      {"if":{"properties":{"op":{"const":"message_delete"}}},"then":{"properties":{"changed":{"const":true},"result":{"type":"object","properties":{"deleted_message_id":{"$ref":"#/$defs/MessageID"},"deleted_thread_id":{"$ref":"#/$defs/ThreadID"}},"required":["deleted_message_id"],"additionalProperties":false}}}}
    ]},
    "ApplyResult":{"type":"object","properties":{"operations":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/OperationResult"}},"storage_revision":{"$ref":"#/$defs/RevisionOrNull"},"canonical_revision":{"$ref":"#/$defs/Revision"}},"required":["operations","storage_revision","canonical_revision"],"additionalProperties":false},
    "SuccessEnvelope":{"type":"object","properties":{"protocol":{"const":2},"command":{"enum":["version","validate","format","fix","thread-list","thread-get","thread-create","thread-move","thread-delete","message-add","message-update","message-delete","apply","source-inspect","editor-update","sync"]},"changed":{"type":"boolean"},"result":{"type":"object"}},"required":["protocol","command","changed","result"],"additionalProperties":false,"allOf":[
      {"if":{"properties":{"command":{"enum":["version","validate","thread-list","thread-get","source-inspect"]}}},"then":{"properties":{"changed":{"const":false}}}},
      {"if":{"properties":{"command":{"enum":["thread-delete","message-delete"]}}},"then":{"properties":{"changed":{"const":true}}}},
      {"if":{"properties":{"command":{"const":"version"}}},"then":{"properties":{"result":{"$ref":"#/$defs/VersionResult"}}}},
      {"if":{"properties":{"command":{"const":"validate"}}},"then":{"properties":{"result":{"oneOf":[{"$ref":"../../v1/schema/v1.json#/$defs/ValidateNormalResult"},{"$ref":"../../v1/schema/v1.json#/$defs/ValidateRepairResult"}]}}}},
      {"if":{"properties":{"command":{"const":"format"}}},"then":{"properties":{"result":{"$ref":"../../v1/schema/v1.json#/$defs/FormatResult"}}}},
      {"if":{"properties":{"command":{"const":"fix"}}},"then":{"properties":{"result":{"$ref":"../../v1/schema/v1.json#/$defs/FixResult"}}}},
      {"if":{"properties":{"command":{"const":"thread-list"}}},"then":{"properties":{"result":{"anyOf":[{"$ref":"#/$defs/ListResult"},{"$ref":"#/$defs/TrackingListResult"}]}}}},
      {"if":{"properties":{"command":{"const":"thread-get"}}},"then":{"properties":{"result":{"anyOf":[{"$ref":"#/$defs/GetResult"},{"$ref":"#/$defs/TrackingGetResult"}]}}}},
      {"if":{"properties":{"command":{"const":"thread-create"}}},"then":{"properties":{"result":{"$ref":"#/$defs/CreateResult"}}}},
      {"if":{"properties":{"command":{"const":"thread-move"}}},"then":{"properties":{"result":{"$ref":"#/$defs/GetResult"}}}},
      {"if":{"properties":{"command":{"const":"message-add"}}},"then":{"properties":{"result":{"$ref":"#/$defs/AddResult"}}}},
      {"if":{"properties":{"command":{"const":"message-update"}}},"then":{"properties":{"result":{"$ref":"#/$defs/MessageResult"}}}},
      {"if":{"properties":{"command":{"const":"thread-delete"}}},"then":{"properties":{"result":{"$ref":"../../v1/schema/v1.json#/$defs/ThreadDeleteResult"}}}},
      {"if":{"properties":{"command":{"const":"message-delete"}}},"then":{"properties":{"result":{"$ref":"../../v1/schema/v1.json#/$defs/MessageDeleteResult"}}}},
      {"if":{"properties":{"command":{"const":"apply"}}},"then":{"properties":{"result":{"$ref":"#/$defs/ApplyResult"}}}},
      {"if":{"properties":{"command":{"const":"source-inspect"}}},"then":{"properties":{"result":{"$ref":"#/$defs/SourceInspectResult"}}}},
      {"if":{"properties":{"command":{"const":"editor-update"}}},"then":{"properties":{"result":{"$ref":"#/$defs/EditorUpdateResult"}}}},
      {"if":{"properties":{"command":{"const":"sync"}}},"then":{"properties":{"result":{"$ref":"#/$defs/SyncResult"}},"allOf":[{"if":{"properties":{"result":{"properties":{"check":{"const":true}}}}},"then":{"properties":{"changed":{"const":false}}}}]}}
    ]},
    "SourceRevisionConflictDetails":{"type":"object","properties":{"kind":{"const":"source_revision"},"expected":{"$ref":"#/$defs/Revision"},"current_source_revision":{"$ref":"#/$defs/Revision"}},"required":["kind","expected","current_source_revision"],"additionalProperties":false},
    "UsageDetails":{"type":"object","properties":{"field":{"enum":["argv","output","body","metadata","operations","revision","source_revision","stdin"]},"reason":{"enum":["missing","required","repeated","malformed","incompatible","too_large","stdin_multiple"]}},"required":["field","reason"],"additionalProperties":false},
    "ValidationDetails":{"type":"object","properties":{"path":{"enum":["target_name","target_type","target_size","target_encoding","target_endings","target_content","source_type","source_size","source_encoding","source_endings","source_coordinate","tracking","lock_type"]},"reason":{"enum":["invalid","symlink","nonregular","multilink","directory","too_large","bom","nul","utf8","endings","location"]}},"required":["path","reason"],"additionalProperties":false},
    "PreconditionDetails":{"type":"object","properties":{"operation":{"enum":["thread_create","thread_move","thread_delete","message_add","message_update","message_delete","thread-create","thread-move","thread-delete","message-add","message-update","message-delete","format","fix","apply","editor-update","sync"]},"reason":{"enum":["id_collision","retry_mismatch","if_last_author_kind","limit_threads","limit_messages_thread","limit_messages_document","limit_selection","limit_tracking","duplicate_thread","not_tracked"]},"index":{"$ref":"#/$defs/Index"}},"required":["operation","reason"],"additionalProperties":false},
    "ErrorEnvelope":{"type":"object","properties":{"protocol":{"const":2},"error":{"type":"object","properties":{"code":{"enum":["usage","validation","repair","conflict","not_found","precondition","io","unsupported"]},"message":{"type":"string"},"details":{"type":"object"}},"required":["code","message","details"],"additionalProperties":false,"oneOf":[
      {"properties":{"code":{"const":"usage"},"message":{"pattern":"^usage:[a-z_]+:[a-z_]+$"},"details":{"$ref":"#/$defs/UsageDetails"}}},
      {"properties":{"code":{"const":"validation"},"message":{"pattern":"^validation:[a-z_]+:[a-z0-9_]+$"},"details":{"$ref":"#/$defs/ValidationDetails"}}},
      {"properties":{"code":{"const":"repair"},"message":{"const":"repair:document"},"details":{"$ref":"../../v1/schema/v1.json#/$defs/RepairDTO"}}},
      {"properties":{"code":{"const":"conflict"},"message":{"const":"conflict:revision"},"details":{"$ref":"../../v1/schema/v1.json#/$defs/RevisionConflictDetails"}}},
      {"properties":{"code":{"const":"conflict"},"message":{"const":"conflict:source_revision"},"details":{"$ref":"#/$defs/SourceRevisionConflictDetails"}}},
      {"properties":{"code":{"const":"conflict"},"message":{"const":"conflict:lock_timeout"},"details":{"$ref":"../../v1/schema/v1.json#/$defs/LockTimeoutConflictDetails"}}},
      {"properties":{"code":{"const":"conflict"},"message":{"const":"conflict:identity_changed"},"details":{"$ref":"../../v1/schema/v1.json#/$defs/IdentityConflictDetails"}}},
      {"properties":{"code":{"const":"not_found"},"message":{"pattern":"^not_found:(thread|message)$"},"details":{"$ref":"../../v1/schema/v1.json#/$defs/NotFoundDetails"}}},
      {"properties":{"code":{"const":"precondition"},"message":{"pattern":"^precondition:[a-z_-]+:[a-z_]+$"},"details":{"$ref":"#/$defs/PreconditionDetails"}}},
      {"properties":{"code":{"const":"io"},"message":{"pattern":"^io:[a-z_]+$"},"details":{"$ref":"../../v1/schema/v1.json#/$defs/IODetails"}}},
      {"properties":{"code":{"const":"unsupported"},"message":{"pattern":"^unsupported:[a-z_]+$"},"details":{"$ref":"../../v1/schema/v1.json#/$defs/UnsupportedDetails"}}}
    ]}},"required":["protocol","error"],"additionalProperties":false}
  }
}
