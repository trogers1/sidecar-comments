{
  "corpus_version": 1,
  "schema": "contracts/schema/executable-v2.json",
  "protocol_schema": "contracts/schema/protocol-v2.json",
  "runner": {
    "default_bin": "./bin/sidecar",
    "env_bin": "SIDECAR_BIN",
    "cli_version_env": "SIDECAR_CLI_VERSION",
    "comparison": "byte-exact after approved template expansion",
    "template_version": 1,
    "templates": {
      "CLI_VERSION": "literal SIDECAR_CLI_VERSION",
      "sha256:initial:PATH": "SHA-256 of initial regular file bytes",
      "sha256:final:PATH": "SHA-256 of expected final regular file bytes",
      "UUIDV7:bind:NAME": "bind a canonical UUIDv7",
      "UUIDV7:ref:NAME": "refer to an earlier binding"
    }
  },
  "requirements": {
    "V2-PROTOCOL": {
      "source": "docs/v2/protocol.md",
      "subject": "version and source inspection without a sidecar"
    },
    "V2-REJECT": {
      "source": "docs/v2/index.md",
      "subject": "fail closed headerless v1 rejection"
    },
    "V2-SYNC": {
      "source": "docs/v2/tracking.md",
      "subject": "empty sync check without source or writes"
    },
    "V1-IDX": {
      "source": "docs/v1/index.md",
      "subject": "target naming, normalized values, deterministic decisions"
    },
    "V1-PRO-ENV": {
      "source": "docs/v1/protocol.md",
      "subject": "envelopes and streams"
    },
    "V1-PRO-DTO": {
      "source": "docs/v1/protocol.md",
      "subject": "all DTOs and revisions"
    },
    "V1-PRO-APPLY": {
      "source": "docs/v1/protocol.md",
      "subject": "Apply request"
    },
    "V1-CLI-SURFACE": {
      "source": "docs/v1/cli.md",
      "subject": "all command surface/output"
    },
    "V1-CLI-INPUT": {
      "source": "docs/v1/cli.md",
      "subject": "inputs/stdin"
    },
    "V1-CLI-READ": {
      "source": "docs/v1/cli.md",
      "subject": "reads"
    },
    "V1-CLI-FORMAT": {
      "source": "docs/v1/cli.md",
      "subject": "format/fix"
    },
    "V1-CLI-MUTATE": {
      "source": "docs/v1/cli.md",
      "subject": "single mutations"
    },
    "V1-CLI-APPLY": {
      "source": "docs/v1/cli.md",
      "subject": "apply"
    },
    "V1-CLI-PRECEDENCE": {
      "source": "docs/v1/cli.md",
      "subject": "precedence"
    },
    "V1-FMT-GRAMMAR": {
      "source": "docs/v1/format.md",
      "subject": "grammar terminals/roles"
    },
    "V1-FMT-FRAMING": {
      "source": "docs/v1/format.md",
      "subject": "body framing"
    },
    "V1-FMT-META": {
      "source": "docs/v1/format.md",
      "subject": "metadata"
    },
    "V1-FMT-EMPTY": {
      "source": "docs/v1/format.md",
      "subject": "empty/noncanonical"
    },
    "V1-FMT-REPAIR": {
      "source": "docs/v1/format.md",
      "subject": "repair"
    },
    "V1-DOM-ID": {
      "source": "docs/v1/domain-and-unicode.md",
      "subject": "UUID"
    },
    "V1-DOM-AUTH": {
      "source": "docs/v1/domain-and-unicode.md",
      "subject": "authors/gitlab"
    },
    "V1-SRC-LOC": {
      "source": "docs/v1/source-and-location.md",
      "subject": "locations"
    },
    "V1-SRC-VAL": {
      "source": "docs/v1/source-and-location.md",
      "subject": "sources"
    },
    "V1-SRC-MUT": {
      "source": "docs/v1/source-and-location.md",
      "subject": "implicit source"
    },
    "V1-STORE-OBJECT": {
      "source": "docs/v1/storage-security.md",
      "subject": "secure objects"
    },
    "V1-STORE-TXN": {
      "source": "docs/v1/storage-security.md",
      "subject": "transaction"
    },
    "V2-TRACKING": {
      "source": "docs/v2/format.md",
      "subject": "retained tracking, explicit excerpt reads, unresolved editor deletion and privacy"
    }
  },
